# Copy as .env for local use. The app runs WITHOUT Gemini.
RADAR_LOCAL_ONLY=1
PUBLIC_URL=http://localhost:8000
TRUSTED_ORIGINS=http://localhost:8000
GEMINI_API_KEY=
# Verify this model remains available to your key/region before production deployment.
GEMINI_MODEL=gemini-3.8-flash
# Leave empty on Gemini 3.x; provider default temperature is recommended.
GEMINI_TEMPERATURE=
# Optional for provisioned admin; otherwise a random password is created on first run.
ADMIN_EMAIL=admin@radar.local
ADMIN_PASSWORD=
# For production use a persistent, writable volume + strong secret.
# RADAR_DATA_DIR=/var/lib/radar
# RADAR_SESSION_KEY=generate_a_long_random_secret_in_production
# Required ONLY for protected 15-min remote polling in production.
RADAR_CRON_TOKEN=
